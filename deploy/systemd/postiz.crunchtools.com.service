#
# The copy of record for /etc/systemd/system/postiz.crunchtools.com.service on
# gloval. /etc/systemd/system is not a git repository there, so a change to the
# host unit lands here first and is copied over.
#
# DEPLOYED BY TICKET, NOT BY TIMER (RT Deploy queue -> crunchtools/deployer).
# Carries io.crunchtools.deploy=deployer and deliberately NO
# io.containers.autoupdate label. It goes live when a Deploy ticket names a
# commit: a window opens, the image is staged with the outgoing one kept as a
# rollback tag, the unit restarts, /p/health must answer and then hold, and a
# failure rolls back and hands the ticket back to the filer.
#
[Unit]
Requires=srv-secrets@postiz.crunchtools.com.service
After=srv-secrets@postiz.crunchtools.com.service
Description=Podman container - postiz.crunchtools.com
Wants=network-online.target
After=network-online.target

[Service]
Type=simple
Restart=always
RestartSec=10
ExecStartPre=/usr/bin/sleep 1.5
ExecStart=/usr/bin/podman run --label io.crunchtools.deploy=deployer --label PODMAN_SYSTEMD_UNIT=postiz.crunchtools.com.service --memory=4g --memory-swap=5g -i --rm --systemd=always   -p 127.0.0.1:8092:5000   --add-host=postiz.crunchtools.com:127.0.0.1   --network crunchtools:alias=mcp-postiz --name postiz.crunchtools.com --hostname postiz.crunchtools.com   --env-file /run/srv-secrets/postiz.crunchtools.com/postiz.env   -v /run/srv-secrets/postiz.crunchtools.com/postiz.env:/etc/postiz/env:ro,Z   -v /srv/postiz.crunchtools.com/config/selfsigned.crt:/etc/nginx/selfsigned.crt:ro,Z   -v /run/srv-secrets/postiz.crunchtools.com/selfsigned.key:/etc/nginx/selfsigned.key:ro   -v /srv/postiz.crunchtools.com/data/postgres:/var/lib/pgsql/data:Z   -v /srv/postiz.crunchtools.com/config/temporal/config.yaml:/etc/temporal/config.yaml:ro,Z \
  -v /srv/postiz.crunchtools.com/data/uploads:/uploads:Z   -v /srv/postiz.crunchtools.com/data/backups:/root/.backups:Z   quay.io/crunchtools/postiz:latest
ExecStop=/usr/bin/podman stop -t 10 postiz.crunchtools.com
ExecStopPost=/usr/bin/podman rm -f postiz.crunchtools.com

[Install]
WantedBy=multi-user.target
