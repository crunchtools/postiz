# ==========================================================================
# Postiz Environment Configuration
# Copy to postiz.env and fill in your values
# ==========================================================================

# ---- Core URLs ----
MAIN_URL=https://postiz.crunchtools.com
FRONTEND_URL=https://postiz.crunchtools.com
NEXT_PUBLIC_BACKEND_URL=https://postiz.crunchtools.com/api
BACKEND_INTERNAL_URL=http://localhost:3000

# ---- Secrets ----
# Generate with: openssl rand -hex 32
JWT_SECRET=CHANGE_ME_GENERATE_RANDOM_STRING

# ---- Database (internal to container) ----
DATABASE_URL=postgresql://postgres@127.0.0.1:5432/postiz
REDIS_URL=redis://127.0.0.1:6379

# ---- Temporal (internal to container) ----
TEMPORAL_ADDRESS=127.0.0.1:7233

# ---- Storage ----
STORAGE_PROVIDER=local
UPLOAD_DIRECTORY=/uploads
NEXT_PUBLIC_UPLOAD_DIRECTORY=/uploads

# ---- App Settings ----
IS_GENERAL=true
DISABLE_REGISTRATION=true
NX_ADD_PLUGINS=false

# ---- Temporal worker footprint ----
# The orchestrator starts one Temporal worker per supported provider unless
# this is set — 31 workers, each with its own Rust core and thread pair, which
# on a single-tenant install is roughly 700MB of native memory outside the V8
# heap. List only the providers you have actually connected.
#
# WARNING: a provider missing from this list gets no worker, so its posts
# enqueue and never execute. Add the identifier here when you connect a new
# provider in the UI, then restart. Grep the orchestrator log for
# "[temporal]" to see the active set.
#
# Leave unset to keep upstream behaviour (a worker for every provider).
POSTIZ_ACTIVE_PROVIDERS=x,linkedin,mastodon,facebook,threads,bluesky

# ---- Social Media API Keys (add as needed) ----
# X_API_KEY=
# X_API_SECRET=
# LINKEDIN_CLIENT_ID=
# LINKEDIN_CLIENT_SECRET=
# REDDIT_CLIENT_ID=
# REDDIT_CLIENT_SECRET=
# MASTODON_URL=
# MASTODON_CLIENT_ID=
# MASTODON_CLIENT_SECRET=
# FACEBOOK_APP_ID=
# FACEBOOK_APP_SECRET=
# THREADS_APP_ID=
# THREADS_APP_SECRET=
# YOUTUBE_CLIENT_ID=
# YOUTUBE_CLIENT_SECRET=
# TIKTOK_CLIENT_ID=
# TIKTOK_CLIENT_SECRET=
# PINTEREST_CLIENT_ID=
# PINTEREST_CLIENT_SECRET=

# ---- AI Features (optional) ----
# OPENAI_API_KEY=

# ---- Email (optional) ----
# RESEND_API_KEY=
# EMAIL_FROM_ADDRESS=
# EMAIL_FROM_NAME=
